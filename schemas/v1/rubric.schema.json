{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benchmark.invalid/schemas/v1/rubric.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "case_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "rubric_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "accepted_value": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "minItems": 1,
            "maxItems": 200,
            "uniqueItems": true
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "claim_id",
          "accepted_value",
          "evidence_ids",
          "weight"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200
    },
    "required_deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "minItems": 1,
            "maxItems": 200,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "evidence_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 200
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "case_revision",
    "rubric_revision",
    "assertions",
    "required_deliverables"
  ],
  "additionalProperties": false,
  "$defs": {}
}
